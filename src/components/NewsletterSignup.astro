---
interface Props {
  variant?: "home" | "compact";
  alwaysVisible?: boolean;
  email?: string;
  headingLevel?: "h1" | "h2";
}

const { variant = "compact", alwaysVisible = false, email = "", headingLevel: Heading = "h2" } = Astro.props;
const id = `letter-${crypto.randomUUID()}`;
const isHome = variant === "home";
---

<section
  class:list={[
    "letter-box",
    isHome ? "letter-box-home" : "letter-box-compact",
    alwaysVisible ? "letter-box-always-visible" : "",
  ]}
  data-letter-box
>
  <div class="letter-box-copy">
    <Heading>
      Newsletter
    </Heading>
    <p>
      Sign up for founder insights, AI observations, and clear explanations of
      things I&rsquo;m learning along the way.
    </p>
  </div>

  <form class="letter-box-form" action="/api/newsletter" method="post" data-letter-form>
    <label class="sr-only" for={id}>Email address</label>
    <input
      id={id}
      value={email}
      maxlength="254"
      aria-describedby={`${id}-message`}
      name="email"
      type="email"
      autocomplete="email"
      placeholder="Enter your email"
      required
      data-letter-email
    />
    <button type="submit" data-letter-submit>
      Subscribe
    </button>
  </form>

  <p id={`${id}-message`} class="letter-box-message" data-letter-message aria-live="polite">
  </p>
</section>

<script>
  const subscribedStorageKey = "newsletter-signed-up";

  document.querySelectorAll<HTMLElement>("[data-letter-box]").forEach((box) => {
    const form = box.querySelector<HTMLFormElement>("[data-letter-form]");
    const emailInput = box.querySelector<HTMLInputElement>("[data-letter-email]");
    const submitButton = box.querySelector<HTMLButtonElement>("[data-letter-submit]");
    const message = box.querySelector<HTMLElement>("[data-letter-message]");
    if (!form || !emailInput || !submitButton || !message) {
      return;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (form.dataset.letterSubmitting === "true") {
        return;
      }

      const email = emailInput.value.trim();
      if (!email) {
        return;
      }

      form.dataset.letterSubmitting = "true";
      submitButton.disabled = true;
      form.setAttribute("aria-busy", "true");
      message.textContent = "Signing you up...";

      try {
        const response = await fetch("/api/newsletter", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ email }),
          signal: AbortSignal.timeout(15000),
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || result?.ok !== true) {
          throw new Error(result?.message || "Something went wrong. Please try again.");
        }

        try { localStorage.setItem(subscribedStorageKey, "true"); } catch {
          // Storage is optional; a successful subscription is still successful.
        }
        form.reset();
        message.textContent = result?.message || "You're on the list. Thank you.";
      } catch (error) {
        message.textContent =
          error instanceof Error && error.name !== "TimeoutError"
            ? error.message
            : "Something went wrong. Please try again.";
      } finally {
        submitButton.disabled = false;
        delete form.dataset.letterSubmitting;
        form.removeAttribute("aria-busy");
      }
    });
  });
</script>
