---
import Layout from "../layouts/Layout.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { normalizeEmail } from "../lib/http";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
const email = normalizeEmail(Astro.url.searchParams.get("email")) ?? "";
const status = Astro.url.searchParams.get("status");
const messages: Record<string, string> = {
  success: "You're on the list. Thank you.",
  invalid: "Please enter a valid email address.",
  unavailable: "Newsletter signup is temporarily unavailable. Please try again.",
};
const message = status ? messages[status] : undefined;
---

<Layout title="Newsletter | Tadas Petra">
  <main id="main-content" tabindex="-1" class="min-h-[70vh] py-16 sm:py-20 md:py-28">
    <NewsletterSignup alwaysVisible email={email} headingLevel="h1" />
    {message && <p class="text-sm text-neutral-600 dark:text-neutral-400" role="status">{message}</p>}
    <a class="plain-link ghost-button mt-6" href="/">Back home</a>
  </main>
</Layout>
