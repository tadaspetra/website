---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Tadas Petra"
  description="The page you are looking for does not exist."
>
  <main class="min-h-[70vh] py-16 sm:py-20 md:py-28">
    <section>
      <p class="mb-3 text-sm tabular-nums text-neutral-400 dark:text-neutral-500">
        404
      </p>
      <h1 class="page-title mb-4">Page not found.</h1>
      <p class="max-w-xl text-base leading-7 text-neutral-600 dark:text-neutral-400">
        The page you are looking for does not exist or may have moved.
      </p>

      <a class="plain-link ghost-button mt-8" href="/">
        Back home
      </a>
    </section>
  </main>
</Layout>
