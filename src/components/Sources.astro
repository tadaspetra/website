---
interface Props {
  sources: { title: string; url: string }[];
}
const { sources } = Astro.props;
const domain = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

{sources.length > 0 && (
  <details class="sources not-prose">
    <summary class="flex min-h-10 w-fit cursor-pointer list-none items-center gap-1.5 rounded-sm text-sm text-neutral-500 dark:text-neutral-400">
      <svg class="size-3 shrink-0" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor">
        <path d="m7 5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {`${sources.length} ${sources.length === 1 ? "source" : "sources"}`}
    </summary>
    <ul class="!m-0 !list-none !pb-0 !pl-4">
      {sources.map((source) => (
        <li class="!pb-0">
          <a href={source.url} target="_blank" rel="noopener noreferrer" class="plain-link flex min-h-10 flex-wrap items-baseline gap-x-2 py-2 text-sm">
            <span>{source.title}</span>
            <span class="text-neutral-500 dark:text-neutral-400">{domain(source.url)}</span>
          </a>
        </li>
      ))}
    </ul>
  </details>
)}

<style>
  details[open] summary svg { transform: rotate(90deg); }
</style>
