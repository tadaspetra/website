---
import { Code } from "astro-expressive-code/components";

interface Snippet {
  id: "rn" | "flutter";
  label: string;
  language: "tsx" | "dart";
  code: string;
}

const snippets: Snippet[] = [
  {
    id: "rn",
    label: "React Native",
    language: "tsx",
    code: `<Pressable
  accessibilityRole="button"
  accessibilityLabel={\`Open \${getBlockHeaderTitle(item.block.title)}\`}
  onPress={onOpen}
  className="flex-row items-center gap-3 rounded-xl border border-border bg-card px-3 py-3"
>
  <View className="min-w-0 flex-1 gap-1 pr-1">
    <Text className="text-base font-medium leading-snug text-foreground">
      {getBlockHeaderTitle(item.block.title)}
    </Text>
    <Text
      className="text-sm leading-snug text-muted-foreground"
      numberOfLines={2}
    >
      {item.block.bodyMarkdown.trim() || "No body yet."}
    </Text>
  </View>
  <Icon as={ChevronRight} size={20} className="text-muted-foreground" />
</Pressable>`,
  },
  {
    id: "flutter",
    label: "Flutter",
    language: "dart",
    code: `@override
Widget build(BuildContext context) {
  return Semantics(
    button: true,
    label: 'Open $title',
    child: InkWell(
      onTap: onOpen,
      borderRadius: BorderRadius.circular(12),
      child: Container(
        padding: const EdgeInsets.symmetric(
          horizontal: 12,
          vertical: 12,
        ),
        decoration: BoxDecoration(
          color: Theme.of(context).cardColor,
          borderRadius: BorderRadius.circular(12),
          border: Border.all(color: Theme.of(context).dividerColor),
        ),
        child: Row(
          children: [
            Expanded(
              child: Padding(
                padding: const EdgeInsets.only(right: 4),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      title,
                      style: TextStyle(
                        fontSize: 16,
                        fontWeight: FontWeight.w500,
                        height: 1.375,
                        color: Theme.of(context).colorScheme.onSurface,
                      ),
                    ),
                    const SizedBox(height: 4),
                    Text(
                      body.trim().isNotEmpty
                          ? body.trim()
                          : 'No body yet.',
                      maxLines: 2,
                      overflow: TextOverflow.ellipsis,
                      style: TextStyle(
                        fontSize: 14,
                        height: 1.375,
                        color: Theme.of(context).colorScheme.onSurfaceVariant,
                      ),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(width: 12),
            Icon(
              Icons.chevron_right,
              size: 20,
              color: Theme.of(context).colorScheme.onSurfaceVariant,
            ),
          ],
        ),
      ),
    ),
  );
}`,
  },
];

interface Stats {
  lines: number;
  chars: number;
  maxDepth: number;
}

function computeStats(code: string, indentSize = 2): Stats {
  let lines = 0;
  let maxDepth = 0;
  for (const row of code.split("\n")) {
    if (row.trim().length === 0) continue;
    lines += 1;
    const leading = row.match(/^(\s*)/)?.[0].length ?? 0;
    const depth = Math.floor(leading / indentSize);
    if (depth > maxDepth) maxDepth = depth;
  }
  return {
    lines,
    chars: code.replace(/\s/g, "").length,
    maxDepth,
  };
}

const instanceId = `code-comparison-${crypto.randomUUID()}`;
const enriched = snippets.map((snippet) => ({
  ...snippet,
  stats: computeStats(snippet.code),
  tabId: `${instanceId}-tab-${snippet.id}`,
  panelId: `${instanceId}-panel-${snippet.id}`,
}));
---

<figure class="code-comparison not-prose my-10 sm:my-12" data-active="rn">
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div
      role="tablist"
      aria-label="Code comparison"
      class="cc-tablist flex items-center gap-1 rounded-full bg-white/60 p-1 text-sm shadow-[var(--shadow-border)] dark:bg-neutral-950/40"
    >
      {
        enriched.map((snippet, idx) => (
          <button
            type="button"
            role="tab"
            id={snippet.tabId}
            data-snippet={snippet.id}
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={snippet.panelId}
            tabindex={idx === 0 ? "0" : "-1"}
            class="cc-tab flex min-h-10 items-center gap-2 rounded-full px-4 py-1.5 font-medium text-neutral-500 transition-colors duration-150 hover:text-neutral-800 aria-selected:bg-neutral-900 aria-selected:text-white dark:text-neutral-400 dark:hover:text-neutral-200 dark:aria-selected:bg-white dark:aria-selected:text-neutral-900"
          >
            {snippet.id === "rn" ? (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="-11.5 -10.23174 23 20.46348"
                width="16"
                height="16"
                aria-hidden="true"
                class="shrink-0"
              >
                <circle cx="0" cy="0" r="2.05" fill="#61dafb" />
                <g stroke="#61dafb" stroke-width="1" fill="none">
                  <ellipse rx="11" ry="4.2" />
                  <ellipse rx="11" ry="4.2" transform="rotate(60)" />
                  <ellipse rx="11" ry="4.2" transform="rotate(120)" />
                </g>
              </svg>
            ) : (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 256 317"
                width="14"
                height="16"
                aria-hidden="true"
                class="shrink-0"
              >
                <path
                  fill="#47C5FB"
                  d="M158 0 0 158l49 48L255 0zM157 145l-85 85 49 50 49-49 85-86z"
                />
                <path fill="#00569E" d="m121 280 37 37h97l-85-86z" />
                <path fill="#00B5F8" d="m72 230 48-48 50 49-49 49z" />
              </svg>
            )}
            {snippet.label}
          </button>
        ))
      }
    </div>

    <div class="flex items-center gap-4">
      {
        enriched.map((snippet) => (
          <div
            class="cc-stats hidden items-baseline gap-4 data-[active=true]:flex"
            data-snippet={snippet.id}
            data-active={snippet.id === "rn" ? "true" : "false"}
          >
            <div class="flex items-baseline gap-1.5">
              <span class="font-mono text-base tabular-nums text-neutral-800 dark:text-neutral-100">
                {snippet.stats.lines}
              </span>
              <span class="text-[10px] uppercase tracking-[0.16em] text-neutral-400 dark:text-neutral-500">
                Lines
              </span>
            </div>
            <div class="flex items-baseline gap-1.5">
              <span class="font-mono text-base tabular-nums text-neutral-800 dark:text-neutral-100">
                {snippet.stats.maxDepth}
              </span>
              <span class="text-[10px] uppercase tracking-[0.16em] text-neutral-400 dark:text-neutral-500">
                Indents
              </span>
            </div>
            <div class="flex items-baseline gap-1.5">
              <span class="font-mono text-base tabular-nums text-neutral-800 dark:text-neutral-100">
                {snippet.stats.chars}
              </span>
              <span class="text-[10px] uppercase tracking-[0.16em] text-neutral-400 dark:text-neutral-500">
                Chars
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="cc-panels mt-4">
    {
      enriched.map((snippet) => (
        <div
          class="cc-panel hidden data-[active=true]:block"
          role="tabpanel"
          id={snippet.panelId}
          aria-labelledby={snippet.tabId}
          data-snippet={snippet.id}
          data-active={snippet.id === "rn" ? "true" : "false"}
          hidden={snippet.id !== "rn"}
          tabindex="0"
        >
          <Code code={snippet.code} lang={snippet.language} />
        </div>
      ))
    }
  </div>
</figure>

<style>
  .code-comparison .cc-panel :global(.expressive-code) {
    margin: 0 !important;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>(".code-comparison")
    .forEach((root) => {
      const tabs = root.querySelectorAll<HTMLButtonElement>(".cc-tab");
      const panels = root.querySelectorAll<HTMLElement>(".cc-panel");
      const statBlocks = root.querySelectorAll<HTMLElement>(".cc-stats");

      function activateTab(tab: HTMLButtonElement, shouldFocus = false) {
        const target = tab.dataset.snippet;
        if (!target) return;

        tabs.forEach((t) => {
          const isActive = t.dataset.snippet === target;
          t.setAttribute("aria-selected", isActive ? "true" : "false");
          t.tabIndex = isActive ? 0 : -1;
        });
        panels.forEach((p) => {
          const isActive = p.dataset.snippet === target;
          p.setAttribute("data-active", isActive ? "true" : "false");
          p.hidden = !isActive;
        });
        statBlocks.forEach((s) =>
          s.setAttribute(
            "data-active",
            s.dataset.snippet === target ? "true" : "false",
          ),
        );
        root.setAttribute("data-active", target);

        if (shouldFocus) {
          tab.focus();
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          activateTab(tab);
        });

        tab.addEventListener("keydown", (event) => {
          const currentIndex = Array.from(tabs).indexOf(tab);
          let nextIndex = currentIndex;

          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            nextIndex = (currentIndex + 1) % tabs.length;
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          } else if (event.key === "Home") {
            nextIndex = 0;
          } else if (event.key === "End") {
            nextIndex = tabs.length - 1;
          } else if (event.key === "Enter" || event.key === " ") {
            activateTab(tab);
            event.preventDefault();
            return;
          } else {
            return;
          }

          event.preventDefault();
          activateTab(tabs[nextIndex], true);
        });
      });
    });
</script>
